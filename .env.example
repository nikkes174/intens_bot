# Telegram
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMINS=123456789,987654321

# Database (aiosqlite — файл; postgresql+asyncpg — для продакшена)
# Docker Compose stores SQLite data in its persistent /app/data volume.
# For running directly on your computer, use sqlite+aiosqlite:///bot.db instead.
DB=sqlite+aiosqlite:////app/data/bot.db

# YooKassa
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxx
YOOKASSA_RETURN_URL=https://t.me/your_bot_username
YOOKASSA_VAT_CODE=1

# Webhook server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
YOOKASSA_WEBHOOK_PATH=/webhooks/yookassa

# Logging
LOG_LEVEL=INFO
